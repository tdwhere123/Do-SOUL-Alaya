        "source_ref": {
          "first": "a10s0",
          "last": "a10s1"
        },
        "text": "3.",
        "utf8_span": [
          700,
          702
        ],
        "span_space": "source_utf8"
      },
      {
        "id": "hostAssertion12",
        "assertion_id": 12,
        "source_ref": {
          "first": "a12s0",
          "last": "a12s32"
        },
        "text": "They are also WaterSense certified, which means they meet EPA criteria for water efficiency and performance.",
        "utf8_span": [
          814,
