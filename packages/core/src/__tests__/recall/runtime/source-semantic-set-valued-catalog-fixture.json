          "last": "a7s35"
        },
        "text": "They offer a wide range of LED light bulbs and fixtures that are compatible with smart home systems.",
        "utf8_span": [
          436,
          536
        ],
        "span_space": "source_utf8"
      },
      {
        "id": "hostAssertion8",
