        "source_ref": {
          "first": "a17s0",
          "last": "a17s37"
        },
        "text": "All of these brands offer stylish and sustainable options for LED lighting and low-flow fixtures for your home.",
        "utf8_span": [
          1283,
          1394
        ],
        "span_space": "source_utf8"
      },
