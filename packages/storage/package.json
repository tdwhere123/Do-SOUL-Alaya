{
  "name": "@do-soul/alaya-storage",
  "version": "0.3.11",
  "private": true,
  "description": "SQLite storage layer for Do-SOUL Alaya — repos, migrations, EventLog.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/tdwhere123/Do-SOUL-Alaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdwhere123/Do-SOUL-Alaya.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-migrations.mjs",
    "test": "pnpm exec vitest run --project @do-soul/alaya-storage",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@do-soul/alaya-cjk-segmentation": "workspace:*",
    "@do-soul/alaya-protocol": "workspace:*",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@do-soul/alaya-soul": "workspace:*",
    "@types/better-sqlite3": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lru-cache": {
      "types": "./src/sqlite/lru-cache.ts",
      "import": "./dist/sqlite/lru-cache.js"
    }
  }
}
