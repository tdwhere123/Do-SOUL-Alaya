{
  "name": "@do-soul/alaya-protocol",
  "version": "4.12.0",
  "private": true,
  "description": "Zod schemas + JSON-schema export for the Do-SOUL Alaya MCP catalog (leaf — no internal deps).",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/tdwhere123/Do-SOUL-Alaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdwhere123/Do-SOUL-Alaya.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm exec vitest run --project @do-soul/alaya-protocol",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cjk-segmentation": {
      "types": "./src/shared/cjk-segmentation.ts",
      "import": "./dist/shared/cjk-segmentation.js"
    },
    "./node/source-frame": {
      "types": "./dist/node/source-frame.d.ts",
      "import": "./dist/node/source-frame.js"
    }
  },
  "dependencies": {
    "@node-rs/jieba": "2.0.3",
    "zod": "^4.6.2"
  }
}
