{
  "name": "@do-soul/alaya-bench-runner",
  "version": "0.3.11",
  "private": true,
  "description": "Daemon-attached bench runner for LongMemEval-S and LoCoMo. Owns the harness; eval package stays a zod-only leaf.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "bin": {
    "alaya-bench-runner": "bin/alaya-bench-runner.mjs"
  },
  "files": ["dist/", "bin/"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm exec vitest run --project @do-soul/alaya-bench-runner",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@do-soul/alaya": "workspace:*",
    "@do-soul/alaya-core": "workspace:*",
    "@do-soul/alaya-engine-gateway": "workspace:*",
    "@do-soul/alaya-eval": "workspace:*",
    "@do-soul/alaya-protocol": "workspace:*",
    "@do-soul/alaya-soul": "workspace:*",
    "@do-soul/alaya-storage": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  }
}
