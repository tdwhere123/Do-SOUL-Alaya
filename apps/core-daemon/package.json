{
  "name": "@do-soul/alaya",
  "version": "0.3.11",
  "private": true,
  "description": "Local-first memory plane for CLI agents (Codex, Claude Code, similar). Provides MCP attach surface and the alaya CLI (15 verbs).",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/tdwhere123/Do-SOUL-Alaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdwhere123/Do-SOUL-Alaya.git",
    "directory": "apps/core-daemon"
  },
  "keywords": [
    "mcp",
    "memory",
    "agent",
    "claude-code",
    "codex",
    "alaya",
    "local-first"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "bin/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp-server": {
      "import": "./dist/mcp/server/mcp-server.js",
      "types": "./dist/mcp/server/mcp-server.d.ts"
    },
    "./cli/bridge": {
      "import": "./dist/cli/bridge.js",
      "types": "./dist/cli/bridge.d.ts"
    },
    "./cli/register": {
      "import": "./dist/cli/register.js",
      "types": "./dist/cli/register.d.ts"
    },
    "./recall/index-response": {
      "import": "./dist/mcp-memory/recall/recall-result.js",
      "types": "./dist/mcp-memory/recall/recall-result.d.ts"
    },
    "./recall/bound-execution": {
      "import": "./dist/recall/recall-bound-execution.js",
      "types": "./dist/recall/recall-bound-execution.d.ts"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "alaya": "./bin/alaya.mjs"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-core-daemon.mjs",
    "build": "tsc -b",
    "test": "pnpm exec vitest run --project @do-soul/alaya-core-daemon",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@do-soul/alaya-core": "workspace:*",
    "@do-soul/alaya-engine-gateway": "workspace:*",
    "@do-soul/alaya-eval": "workspace:*",
    "@do-soul/alaya-inspector": "workspace:*",
    "@do-soul/alaya-protocol": "workspace:*",
    "@do-soul/alaya-soul": "workspace:*",
    "@do-soul/alaya-storage": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "^4.13.7",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "pino-pretty": "^13.1.3"
  }
}
