# Do-SOUL Alaya — example environment configuration.
#
# Copy the relevant lines into your shell or into the daemon config env file
# (`~/.config/alaya/.env`, written by `alaya install`) and fill in real values.
# Every variable here is OPTIONAL unless marked "required"; Alaya runs with
# sane defaults when a variable is unset.
#
# NEVER commit real secrets. Use secret-refs (`env:NAME` / `file:/abs/path` /
# `keychain:service:account`) instead of inlining keys; the actual secret value
# lives only in the referenced location.

# ── Credentials & secret-refs ────────────────────────────────────────────────
# Secret-ref for the embedding / OpenAI-compatible key (scheme env:/file:/keychain:).
ALAYA_OPENAI_SECRET_REF=env:OPENAI_API_KEY
# Actual OpenAI API key, read when the secret-ref above resolves to env:OPENAI_API_KEY.
OPENAI_API_KEY=<your-openai-api-key>
# Secret-ref for the official Garden provider credential.
ALAYA_OFFICIAL_GARDEN_SECRET_REF=env:OPENAI_API_KEY
# Legacy alias for the Garden secret-ref (kept for back-compat; prefer the official one above).
ALAYA_GARDEN_OPENAI_SECRET_REF=env:OPENAI_API_KEY
# Garden provider kind selected at install time (e.g. official_api / openai).
ALAYA_GARDEN_PROVIDER_KIND=official_api
# Model id the official Garden uses (default in code: gpt-4.1-mini).
OFFICIAL_API_GARDEN_MODEL=<your-garden-model>
# Base URL for the official Garden provider.
# OFFICIAL_API_GARDEN_PROVIDER_URL=<your-garden-provider-url>

# ── Embedding ────────────────────────────────────────────────────────────────
# Embedding backend. Only "local_onnx" or "openai" are accepted; any other value throws.
# Unset defaults to local_onnx in daemon config; openai requires explicit opt-in plus credentials.
ALAYA_EMBEDDING_PROVIDER=local_onnx
# Master switch for the embedding recall supplement ("true"/"false"); embedding never decides durable truth.
ALAYA_ENABLE_EMBEDDING_SUPPLEMENT=true
# OpenAI-compatible embedding model id (when not using local_onnx).
OPENAI_EMBEDDING_MODEL=<your-embedding-model>
# Base URL for the OpenAI-compatible embedding endpoint.
OPENAI_EMBEDDING_PROVIDER_URL=<your-embedding-provider-url>
# Local ONNX embedding model id (when ALAYA_EMBEDDING_PROVIDER=local_onnx).
ALAYA_LOCAL_EMBEDDING_MODEL=<your-local-embedding-model>
# Directory where the downloaded local embedding model is cached.
ALAYA_LOCAL_EMBEDDING_CACHE_DIR=<your-cache-dir>
# Hugging Face mirror endpoint used when fetching the local model.
HF_ENDPOINT=<your-hf-endpoint>
# Opt-in host-wide single-flight lock for local ONNX embed/CE inference across
# processes (1/true/on/yes). Off by default — single-process daemon scores are
# unchanged either way; enable when multiple local ONNX workers share a host so
# thread pools do not oversubscribe. Optional lock path override below.
# ALAYA_LOCAL_ONNX_HOST_SINGLE_FLIGHT=1
# ALAYA_LOCAL_ONNX_LOCK_PATH=<absolute-lock-db-path>
# SQLite worker-thread write queue is ON by default for file DBs (EventLog
# standalone appends off the main connection). Set to 0/false/off/disabled to
# force main-thread sync writes.
# ALAYA_SQLITE_WRITE_QUEUE=0

# ── Runtime / daemon ─────────────────────────────────────────────────────────
# Override the Alaya config directory (default: XDG config home / ~/.config/alaya).
ALAYA_CONFIG_DIR=<your-config-dir>
# HTTP port the core daemon listens on (default DEFAULT_DAEMON_PORT=5173 in code).
PORT=5173
# Bind address for the HTTP daemon (default 127.0.0.1).
# DAEMON_HOST=127.0.0.1
# Allowed CORS origin for the daemon (default http://localhost:5173).
# NOTE: the origin check only defends browser CSRF — ALAYA_REQUEST_TOKEN is the
# sole real authentication. The daemon admits origin-less desktop requests
# (allowDesktopOriginlessRequests); when exposing the daemon beyond localhost
# (ALAYA_ALLOW_REMOTE_DAEMON=1) prefer disabling that and rely on the token.
ALLOWED_ORIGIN=http://localhost:5173
# Per-request auth token; a random token is generated when unset. Set this to a
# strong secret whenever the daemon is reachable beyond localhost.
ALAYA_REQUEST_TOKEN=<your-request-token>
# Identity recorded for reviewer (governance) actions.
ALAYA_REVIEWER_IDENTITY=<your-reviewer-identity>
# Token authorizing reviewer (governance) actions.
ALAYA_REVIEWER_TOKEN=<your-reviewer-token>
# Set to "claude_code" to mark the principal runtime as Claude Code.
ALAYA_PRINCIPAL_RUNTIME=<your-principal-runtime>
# Default workspace id when an agent attaches without an explicit --workspace.
ALAYA_WORKSPACE_ID=<your-workspace-id>
# Comma-separated absolute repo roots Alaya is allowed to resolve workspaces under.
ALAYA_REPO_ROOTS=<your-repo-root-1>,<your-repo-root-2>
# Comma-separated allowlist of MCP server names the agent may attach.
ALAYA_ALLOWED_MCP_SERVERS=<server-1>,<server-2>
# Set to "1" to enable verbose CLI debug logging.
ALAYA_DEBUG=0
# Structured daemon log level (trace/debug/info/warn/error/fatal). LOG_LEVEL is also accepted.
ALAYA_LOG_LEVEL=info

# ── Conflict-detection LLM ───────────────────────────────────────────────────
# Enable conflict detection ("true"/"false").
ALAYA_CONFLICT_DETECTION_ENABLED=false
# Enable the rule-based conflict pass ("true"/"false").
ALAYA_CONFLICT_RULE_ENABLED=false
# API key for the conflict-detection LLM.
ALAYA_CONFLICT_LLM_API_KEY=<your-conflict-llm-key>
# Conflict-detection LLM model. Unset/empty disables conflict LLM calls (no vendor default).
# ALAYA_CONFLICT_LLM_MODEL=<your-conflict-llm-model>
# Secret-ref alternative to ALAYA_CONFLICT_LLM_API_KEY.
# ALAYA_CONFLICT_LLM_SECRET_REF=env:OPENAI_API_KEY
# Base URL for the conflict-detection LLM provider.
ALAYA_CONFLICT_LLM_PROVIDER_URL=<your-conflict-llm-url>
# Timeout in milliseconds for conflict-detection LLM calls.
ALAYA_CONFLICT_LLM_TIMEOUT_MS=<timeout-ms>

# ── Feature flags ────────────────────────────────────────────────────────────
# Enable ingest reconciliation ("true"/"false").
ALAYA_INGEST_RECONCILIATION_ENABLED=false
# Disable orphan detection by setting to "false" (enabled by default).
ORPHAN_DETECTION_ENABLED=true
# TTL in milliseconds for path-relationship co-usage counters.
ALAYA_PATHREL_COUNTER_TTL_MS=<ttl-ms>
# Enable content-strength scoring for path relationships (on/1/true). Off by default.
# ALAYA_PATHREL_CONTENT_STRENGTH=1

# ── Benchmark harness (apps/bench-runner) ────────────────────────────────────
# Root directory for off-release bench artifacts.
ALAYA_BENCH_ARTIFACT_ROOT=<your-bench-artifact-root>
# Directory holding bench datasets.
ALAYA_BENCH_DATA_DIR=<your-bench-data-dir>
# Set to "1" to apply fast (less durable) SQLite pragmas during benches.
ALAYA_BENCH_FAST_PRAGMA=0
# SQLite temp_store override for bench runs (e.g. MEMORY).
ALAYA_BENCH_TEMP_STORE=<temp-store>

# ── Security / bind / token isolation ────────────────────────────────────────
# Set to 1 to allow private/intranet provider URLs (disables the private-URL block).
# ALAYA_ALLOW_PRIVATE_PROVIDER_URL=1
# Set to 1 to allow the daemon HTTP server beyond localhost.
# ALAYA_ALLOW_REMOTE_DAEMON=1
# Set to 1 to allow wildcard bind (0.0.0.0). Default refuses it.
# ALAYA_ALLOW_WILDCARD_BIND=1
# Unix socket path for the daemon (when not using TCP).
# ALAYA_DAEMON_SOCKET=<absolute-socket-path>
# Comma-separated workspace ids this request token may access.
# ALAYA_REQUEST_TOKEN_WORKSPACES=<workspace-id-1>,<workspace-id-2>
# Token that must be presented before destructive MCP tools run.
# ALAYA_MCP_TOOL_CONFIRMATION_TOKEN=<confirmation-token>
# JSON catalog of extra MCP servers the daemon may launch.
# ALAYA_MCP_SERVER_CONFIG_JSON=<json>
# MCP tool timeout in milliseconds.
# ALAYA_MCP_TOOL_TIMEOUT_MS=<timeout-ms>
# Zero-day policy JSON (security posture; leave unset unless you mean to override).
# ZERO_DAY_POLICIES_JSON=<json>
# Node environment (development/production/test). Not an Alaya-specific switch.
# NODE_ENV=production
# Alias for ALAYA_LOG_LEVEL.
# LOG_LEVEL=info

# ── Additional registered runtime keys ───────────────────────────────────────
# Keep unrouted facts instead of dropping them.
# ALAYA_RETAIN_UNROUTED_FACTS=1
# Include the full turn in evidence materialization.
# ALAYA_EVIDENCE_FULL_TURN=1
# Materialization confidence floor (numeric).
# ALAYA_MATERIALIZATION_CONF_FLOOR=<floor>
# Robust source-ref recall behavior.
# ALAYA_RECALL_SOURCE_REF_ROBUST=1
# Dual-encoder-to-query embedding recall.
# ALAYA_RECALL_D2Q=1
# Retired local cross-encoder rerank is ignored. Unset
# ALAYA_ENABLE_LOCAL_CROSS_ENCODER_RERANK and companion model/cache keys;
# they emit the shared unregistered/retired env warning and do not change ranking.
# Opt-in cloud edge-LLM producer (default off).
# ALAYA_EDGE_PRODUCER_LLM_ENABLED=0
# Route EDGE_CLASSIFY through the host worker.
# ALAYA_EDGE_CLASSIFY_HOST_WORKER=1
# Recall-read worker per-request timeout in milliseconds.
# ALAYA_RECALL_READ_WORKER_REQUEST_TIMEOUT_MS=<timeout-ms>
# Recall projection allowlist.
# ALAYA_RECALL_PROJECTIONS=<projection-list>
# Extra synonym clusters for recall.
# ALAYA_RECALL_EXTRA_SYNONYM_CLUSTERS=<json>
# Embedding backfill concurrency.
# ALAYA_EMBEDDING_BACKFILL_CONCURRENCY=<n>
# Embedding recall tier list.
# ALAYA_EMBEDDING_RECALL_TIERS=<tiers>
# Embedding workspace scan cap.
# ALAYA_EMBEDDING_WORKSPACE_SCAN_CAP=<n>
