{
  "name": "do-soul-alaya",
  "version": "0.3.11",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Do-SOUL Alaya — local-first memory plane for CLI agents. Distributed via GitHub Releases, not npm install @do-soul/alaya-*",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.3.4 <13"
  },
  "bin": {
    "alaya": "./bin/alaya.mjs"
  },
  "scripts": {
    "build": "node ./scripts/build-existing.mjs",
    "test": "node ./scripts/ci/run-vitest-projects.mjs",
    "test:coverage": "node ./scripts/ci/run-vitest-projects.mjs --coverage.enabled --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=lcov",
    "test:parallel": "vitest run --config vitest.config.mjs",
    "ci:content-contracts": "node ./scripts/ci/check-content-contracts.mjs",
    "ci:audit": "node ./scripts/ci/check-audit.mjs",
    "ci:test-as-any": "node ./scripts/ci/check-test-as-any.mjs",
    "ci:throw-new-error": "node ./scripts/ci/check-throw-new-error.mjs",
    "ci:env-docs": "node ./scripts/ci/check-env-docs.mjs",
    "ci:doc-links": "node ./scripts/ci/check-doc-links.mjs",
    "ci:install-scripts": "node --test ./scripts/ci/check-install-scripts.test.mjs",
    "ci:repository-structure": "node ./scripts/ci/check-repository-structure.mjs",
    "typecheck": "pnpm --workspace-concurrency=1 --filter @do-soul/alaya-protocol --filter @do-soul/alaya-graph-algorithms --filter @do-soul/alaya-cjk-segmentation --filter @do-soul/alaya-core --filter @do-soul/alaya-storage --filter @do-soul/alaya-engine-gateway --filter @do-soul/alaya-eval --filter @do-soul/alaya-inspector --filter @do-soul/alaya-bench-runner --filter @do-soul/alaya-soul --filter @do-soul/alaya run typecheck",
    "hygiene:unused": "knip --config knip.json --no-progress --no-config-hints",
    "hygiene:no-console": "node ./scripts/ci/check-no-console.mjs",
    "hygiene:process-env": "node ./scripts/ci/check-process-env.mjs",
    "hygiene:storage-row-casts": "node ./scripts/ci/check-storage-row-casts.mjs",
    "ci:changelog-version": "node ./scripts/ci/check-changelog-version.mjs",
    "hygiene:unused-exports": "node ./scripts/ci/check-unused-package-exports.mjs",
    "hygiene:inspector-deps": "node ./scripts/ci/check-inspector-dep-isolation.mjs",
    "release:check-version": "node ./scripts/check-release-version.mjs",
    "fixtures:host-autonomy-witness": "node ./scripts/export-host-autonomy-witness.mjs",
    "alaya": "node ./bin/alaya.mjs",
    "doctor": "node ./bin/alaya.mjs doctor",
    "inspector": "node ./bin/alaya.mjs inspect --open"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "better-sqlite3": "catalog:",
    "knip": "6.35.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
