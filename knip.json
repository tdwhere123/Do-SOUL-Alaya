{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted", "unresolved", "catalog", "catalogReferences", "enumMembers", "namespaceMembers"],
  "ignore": [
    "vendor/**",
    "dist/**",
    "coverage/**",
    "shard-coverage/**",
    "shard-manifests/**",
    "scripts/analyze-recall-bias.mjs",
    "scripts/append-bench-degradation-backlog.mjs",
    "scripts/compute-bench-quality-metrics.mjs",
    "scripts/compute-bench-quality-metrics-utils.mjs",
    "scripts/compute-cohort-from-archive.mjs",
    "scripts/fetch-local-embedding-model.mjs",
    "scripts/vacuum-into.mjs",
    "scripts/resolve-live-db-path.mjs",
    "scripts/local-embedding-cache-dir.mjs",
    "scripts/run-full-bench-v0311.mjs",
    "scripts/run-full-bench-v0311-cli.mjs",
    "scripts/bench-sqlite-concurrency.mjs"
  ],
  "ignoreWorkspaces": ["vendor/**"],
  "entry": [
    "bin/alaya.mjs",
    "scripts/*.mjs",
    "vitest.config.mjs",
    "vitest.workspace.mjs"
  ],
  "project": [
    "bin/**/*.mjs",
    "scripts/**/*.mjs",
    "vitest*.mjs",
    "tsconfig.base.json"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
        "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
        "scripts/configured-paths.d.mts"
      ]
    },
    "packages/protocol": {
      "entry": ["src/index.ts", "src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "packages/cjk-segmentation": {
      "entry": ["src/index.ts", "src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "packages/storage": {
      "entry": [
        "src/index.ts",
        "src/sqlite/write-queue/worker.ts",
        "src/__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/embedding-recall/local-onnx-embedding-client.ts",
        "src/embedding-recall/local-onnx-process/child.ts",
        "src/recall/conditional-field/query/source-semantic-joint-witness.ts",
        "src/__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "packages/soul": {
      "entry": ["src/index.ts", "src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "packages/engine-gateway": {
      "entry": ["src/index.ts", "src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "apps/core-daemon": {
      "entry": [
        "src/index.ts",
        "src/runtime/recall/recall-read-worker.ts",
        "src/__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tsconfig.json"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/bench-runner": {
      "entry": [
        "src/cli/index.ts",
        "src/runs/lifecycle/recall-eval/recall-eval-process/child.ts",
        "src/runs/frozen-answer/launch.ts",
        "src/__tests__/**/*.test.ts",
        "bin/*.mjs",
        "scripts/*.mjs",
        "scripts/*.sh"
      ],
      "project": ["src/**/*.ts", "bin/**/*.mjs", "scripts/**/*.{mjs,sh}", "tsconfig.json"]
    },
    "apps/inspector": {
      "entry": ["src/app.ts", "src/server.ts", "src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "tsconfig.json"]
    },
    "apps/inspector/web": {
      "entry": [
        "src/main.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.ts", "tsconfig*.json"]
    }
  }
}
